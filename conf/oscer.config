// OSCER. The scratch, OURdisk and queue names are hardcoded rather than params: they vary by
// site, not by run.

workDir = "/scratch/${System.getenv('USER')}/merfish-mouse-testis_work/${params.run_id}"

process {
    container     = 'oras://ghcr.io/brent-biddy/python_cpu-sif:1.0.2'
    executor      = 'slurm'
    queue         = 'normal'
    cpus          = 8
    // Scales with the attempt so a task that died on memory gets more.
    memory        = { 32.GB * task.attempt }
    time          = { 4.h + (task.attempt - 1) * 4.h }
    errorStrategy = 'retry'
    maxRetries    = 3

    withLabel: 'gpu' {
        container        = 'oras://ghcr.io/brent-biddy/python_gpu-sif:1.0.2'
        queue            = 'sooner_gpu_test'
        clusterOptions   = '--gres=gpu:1'
        // --no-home and TMPDIR repeated because this replaces nextflow.config's containerOptions.
        containerOptions = { '--no-home --nv' +
            " --env TMPDIR=${task.workDir}" }
    }
}

apptainer {
    enabled      = true
    runOptions   = '--writable-tmpfs'
    // `env -` drops SLURM's CUDA_VISIBLE_DEVICES, so cupy takes device 0, not the allocated card.
    envWhitelist = 'CUDA_VISIBLE_DEVICES'
    // Scratch's 14-day delete goes by creation time, so a cache there dies every fortnight.
    // Shared across every repo on this cluster, not just this one's workDir, so a pull for
    // one is reused by another.
    cacheDir     = '/ourdisk/hpc/lilab/babiddy/dont_archive/apptainer_cache'
    // Headroom against GHCR throttling the pull, which has happened before and could recur --
    // not OCI-to-SIF conversion, which a published SIF never pays.
    pullTimeout  = '2h'
}
