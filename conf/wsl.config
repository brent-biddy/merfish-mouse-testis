// Laptop / WSL2 box.

process {
    // An oras:// artifact is already a SIF, so the pull skips the OCI-to-SIF conversion.
    container     = 'oras://ghcr.io/brent-biddy/python_cpu-sif:1.0.2'
    executor      = 'local'
    cpus          = 4
    memory        = '16.GB'
    // Fail fast on a typo rather than burn retries interactively.
    errorStrategy = 'finish'

    withLabel: 'gpu' {
        container = 'oras://ghcr.io/brent-biddy/python_gpu-sif:1.0.2'
        // --nv does not work under WSL2: libcuda.so needs its companions from /usr/lib/wsl/lib.
        // --no-home and TMPDIR repeated because this replaces nextflow.config's containerOptions.
        containerOptions = { '--no-home --bind /usr/lib/wsl' +
            ' --env LD_LIBRARY_PATH=/usr/lib/wsl/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64' +
            " --env TMPDIR=${task.workDir}" }
    }

    // merscope() picks rioxarray over dask_image when it's importable, and uses much less
    // memory doing it -- confirmed against b2r0_cellpose3d, where dask_image was killed
    // writing the zarr store and rioxarray finished. Local-only: the container used here is
    // built at ~/containers_local/python_cpu_rioxarray.sif and is not the published image,
    // since rioxarray's rasterio dependency conflicts with pinned versions on the shared
    // build -- see brent-biddy/bioinfo-containers for that attempt and its revert.
    withName: 'CREATE_SPATIALDATA$' {
        container = "${System.getenv('HOME')}/containers_local/python_cpu_rioxarray.sif"
    }
    withName: 'CREATE_SPATIALDATA_CELLPOSE$' {
        container = "${System.getenv('HOME')}/containers_local/python_cpu_rioxarray.sif"
    }
}

apptainer {
    enabled    = true
    runOptions = '--writable-tmpfs'
    // Shared across every repo on this machine, not just this one's workDir, so the same
    // image pulled for a different pipeline is reused rather than duplicated.
    cacheDir   = "${System.getenv('HOME')}/apptainer_cache"
}
