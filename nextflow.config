params {
    // Required: pipeline step to run. Valid values are steps.nf's valid_steps.
    step        = null

    // Required: path to a samplesheet CSV (columns vary by step — see steps.nf's header)
    samplesheet = null

    // create_centroids only: obs column to sum over. Null sweeps the leiden columns.
    group_by    = null

    // annotate_celltypes only: centroid CSV to correlate against. Null uses assets/reference.
    reference   = null

    // Render steps only, and required: the .qmd to render.
    qmd         = null

    // Render steps only: one of the formats the .qmd declares. Render twice for both.
    to          = 'pptx'

    // Names both dirs a run writes. Pin with --run_id for -resume across launches.
    //   results/20260901_153157/                        published beside the code
    //   ~/merfish-mouse-testis_work/20260901_153157/    work dir, or /scratch under -profile oscer
    run_id      = new java.text.SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())

    // Beside the code: results/ is gitignored, reports/ is committed.
    outdir      = "${projectDir}/results/${params.run_id}"
}

// Defaults apply unconditionally; a profile (conf/<name>.config) states only its
// difference — container, executor, resource caps, errorStrategy, and where its
// cache/work dir lives.
// Beside outdir, in-repo, and one dir per run so a -stub run never shares a workDir with a
// real one. oscer.config moves this to scratch, since OSCER home has no room for it.
workDir = "${projectDir}/work/${params.run_id}"

// Dropped on success only, so resume-after-failure still works.
cleanup = true

process {
    // Nextflow forwards only the launching shell's TMPDIR, and a local run has none, so scratch
    // would land in the host's shared /tmp. --no-home: Apptainer bind-mounts $HOME by default,
    // which leaked the host's own conda tree and other projects' Jupyter kernelspecs into every
    // container; the images now redirect their own config/cache dirs into /tmp so this doesn't
    // break them (see bioinfo-containers@bb7c8c6). A site-specific containerOptions in conf/
    // replaces, not merges with, this one — repeat both flags there if one is ever added.
    containerOptions = { "--no-home --env TMPDIR=${task.workDir}" }
}

// Forgetting -profile runs with no container configured rather than silently picking one.
// Adding a cluster is a copy of conf/oscer.config plus one line here.
profiles {
    wsl   { includeConfig 'conf/wsl.config'   }
    oscer { includeConfig 'conf/oscer.config' }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }

manifest {
    name        = 'merfish-mouse-testis'
    description = 'Vizgen MERSCOPE (MERFISH) analysis of mouse testis'
    version     = '0.1.0'
    nextflowVersion = '>=23.0'
}
