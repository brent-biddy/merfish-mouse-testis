# Data and outputs are never committed — they are reproducible from bin/ + assets/.
data/
results/
results_*/
work/

# The markdown and its figures are committed, being the copy GitHub renders; the deck is
# not, git having nothing useful to say about it. Rebuild it by rendering.
reports/**/*.pptx
notebooks/**/*.pptx

.nextflow/
.nextflow.log*

# Supplementary workbooks the reference CSVs were derived from; only the CSVs are read.
assets/reference/*.xlsx

# Quarto / Jupyter
*.quarto_ipynb
.quarto/
# Scoped to notebooks/: the same-named directory under reports/ holds committed figures.
notebooks/**/*_files/
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
.venv/
